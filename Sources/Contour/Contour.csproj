<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <Copyright>Social Discovery Ventures © 2022</Copyright>
    <Company>Social Discovery Ventures</Company>
    <Authors>SDV Team</Authors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Packaging for the Cupid Media feed. The GitHub workflows read the Version element below. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Contour</PackageId>
    <Version>7.0.0-pr1</Version>
    <Title>Contour Service Bus</Title>
    <Description>The package contains abstract interfaces of service bus and transport implementations for AMQP/RabbitMQ and Kafka</Description>
    <PackageTags>contour servicebus bus</PackageTags>
    <PackageReleaseNotes>Contour 7 with W3C trace context propagation</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/cupid-media/Contour</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/cupid-media/Contour</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
    <PackageReference Include="Confluent.Kafka" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
      <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net6.0'">
      <PackageReference Include="System.Configuration.ConfigurationManager" Version="7.0.0" />
    </ItemGroup>
</Project>